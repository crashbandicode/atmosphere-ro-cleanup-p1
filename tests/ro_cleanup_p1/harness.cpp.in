int stage = 0, unmaps = 0;
ams::Result MapNro(...) { return ams::Result(stage == 1 ? 0x416 : 0); }
ams::Result UnmapNro(...) { ++unmaps; return ams::Result(0x616); }
struct Context {
    int GetProcessHandle() { return 7; }
    ams::Result ParseNro(...) { return ams::Result(stage == 2 ? 0x1216 : 0); }
} process;
